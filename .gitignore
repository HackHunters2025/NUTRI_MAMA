# ------------------------------
# 🧠 BACKEND (Python / ML)
# ------------------------------

# Ignore logs
backend/app/ml_scripts/logs/

# Ignore Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Ignore optimizer states
**/optimizer.pt

# Ignore temporary notebook files
.ipynb_checkpoints/

# Ignore environment files
.env
backend/.env
frontend/.env

# Ignore large trained model files
*.safetensors
*.pt
*.pth

# Ignore trained model directory
backend/trained_symptom_model/

# Ignore virtual environment
venv/
backend/venv/
.venv/
.env/

# ------------------------------
# ⚛️ FRONTEND (React / Vite)
# ------------------------------

# Node modules
node_modules/
frontend/node_modules/

# Build output
dist/
frontend/dist/
build/
frontend/build/

# Local environment and config
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.tmp/

# ------------------------------
# 🧰 Editor / System Files
